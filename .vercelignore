# Vercel deployment exclusions — non-runtime payloads only.
# Runtime copies of circuits and Rive assets live under public/ and are
# deliberately NOT excluded (public/circuits, public/rive are preserved).

# Git metadata
/.git/

# Local build / dependency caches
/node_modules/
/.next/
/out/
/tsconfig.tsbuildinfo

# Test artifacts
/coverage/
/playwright-report/
/test-results/

# Documentation and tests (not part of the runtime bundle)
/docs/
/tests/

# Native mobile project
/ios/

# Root source-only directories (runtime copies live under public/)
/contracts/
/circuits/
/rive/
