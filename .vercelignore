# Shrink deploy upload / build-cache noise. Runtime assets that the app needs
# must live under public/ or be imported by the Next app — not listed here.
# See docs/OPERATIONS.md §5 (Deployment Storage Rules).

# Smart contracts / Foundry
contracts/

# Circuit sources (runtime uses public/circuits/*.json only)
circuits/

# Rive design sources (runtime uses public/rive/*)
rive/

# Mobile / Capacitor
ios/
android/
mobile/

# Test & report artifacts
playwright-report/
test-results/
coverage/
tests/
**/*.spec.ts
**/*.spec.tsx
**/*.test.ts
**/*.test.tsx

# Local / editor
.next/
.turbo/
.vscode/
.idea/
*.md
!README.md
docs/

# Keep scripts/ — postinstall (copy-rive-wasm) runs on Vercel install
*.log
.env*
!.env.example
!.env.local.template
