            <StateMachineTrigger name="prPulse" id="0:47"/>

            <StateMachineLayer name="Main" id="0:8">
                <AnyState x="560" y="-140">
                    <StateTransition stateToId="0:14" duration="220" interpolationType="linear">
                        <TransitionBoolCondition inputId="0:43" opValue="equal"/>
                    </StateTransition>
                    <StateTransition stateToId="0:13" duration="280" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionBoolCondition inputId="0:40" opValue="equal"/>
