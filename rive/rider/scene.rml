            </KeyedObject>
            <KeyedObject objectId="0:45">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:23">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="96" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:24">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="96" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Celebrate: burst pops in and out (FX layer). -->
        <LinearAnimation duration="30" name="Celebrate" id="0:63">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.2" frame="8" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="15" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="30" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.2" frame="8" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="15" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="30" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="8" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="30" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Ready: pre-ride greeting — pedals parked, eager upright bounce. -->
        <LinearAnimation duration="48" loopValue="loop" name="Ready" id="0:94">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="-3" frame="24" interpolationType="cubic"/>
                    <KeyFrameDouble value="0" frame="48" interpolationType="cubic"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
