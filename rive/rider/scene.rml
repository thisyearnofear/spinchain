        <!--
          Pedal-cycle key tables (front leg at crank angle θ, rear at θ+180°),
          from an 8-pose two-bone IK solve of hip(62,76) → crank circle
          c(76,116) r=10, thigh 26 / calf 28:
          θ:      0      45     90     135    180    225    270    315
          thigh:  1.090  0.734  0.562  0.659  0.865  1.153  1.396  1.366
          calf:  -1.057 -0.602 -0.557 -0.986 -1.463 -1.798 -1.823 -1.524
          Crank node rotation = θ − π/2 (arm drawn pointing +y).
        -->

        <!-- Idle: parked, pedals level, flame out. Keys are absolute. -->
        <LinearAnimation duration="1" name="Idle" id="0:60">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="2.3166" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:40">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="1.090" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:41">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-1.057" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:42">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="0.865" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:43">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-1.463" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:44">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-1.5708" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:45">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="1.5708" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- PedalEasy (≤70 rpm): 64-frame rev ≈ 56 RPM at 60 fps. -->
        <LinearAnimation duration="64" loopValue="loop" name="PedalEasy" id="0:61">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="2.30" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:40">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="1.090" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.734" frame="8" interpolationType="linear"/>
                    <KeyFrameDouble value="0.562" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="0.659" frame="24" interpolationType="linear"/>
                    <KeyFrameDouble value="0.865" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="1.153" frame="40" interpolationType="linear"/>
                    <KeyFrameDouble value="1.396" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="1.366" frame="56" interpolationType="linear"/>
                    <KeyFrameDouble value="1.090" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:41">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-1.057" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-0.602" frame="8" interpolationType="linear"/>
                    <KeyFrameDouble value="-0.557" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="-0.986" frame="24" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.463" frame="32" interpolationType="linear"/>
