        </Shape>
        <Shape x="68.5" y="100.5" rotation="-2.6906" name="SeatTube">
            <Rectangle width="4" height="34" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="82.5" y="83.5" rotation="1.6405" name="TopTube">
            <Rectangle width="4" height="43" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="92" y="103" rotation="2.2505" name="DownTube">
            <Rectangle width="4" height="41" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="112" y="104" rotation="0.2783" name="Fork">
            <Rectangle width="4" height="29" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="64" y="117" rotation="-1.4877" name="Chainstay">
            <Rectangle width="4" height="24" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>

        <!-- Wheels + hubs. -->
        <Shape x="52" y="118" name="RearHub" id="0:32">
            <Ellipse width="9" height="9" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF94A3B8" name="Color"/></Fill>
        </Shape>
        <Shape x="52" y="118" name="RearWheel" id="0:23">
            <Ellipse width="44" height="44" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="6" name="Stroke"><SolidColor colorValue="FF334155" name="Color"/></Stroke>
        </Shape>
        <Shape x="116" y="118" name="FrontHub" id="0:33">
            <Ellipse width="9" height="9" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF94A3B8" name="Color"/></Fill>
        </Shape>
        <Shape x="116" y="118" name="FrontWheel" id="0:24">
            <Ellipse width="44" height="44" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="6" name="Stroke"><SolidColor colorValue="FF334155" name="Color"/></Stroke>
        </Shape>

        <!-- Invisible hit area for the pointer listeners below. -->
        <Shape x="84" y="82" name="RiderHitArea" id="0:97">
            <Rectangle width="112" height="125" cornerRadiusTL="12" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="00FFFFFF" name="Color"/></Fill>
        </Shape>

        <StateMachine name="Ride" id="0:7">
            <!-- Legacy input trigger for the right-click celebrate. (Listener
                 writes to VM triggers DO work — re-verified on runtime 2.44.2 —
                 but only when the ViewModelInstance declares a
                 ViewModelInstanceTrigger default; this input path stays because
                 the web button-filter bug still needs the host to fire it.) -->
            <StateMachineTrigger name="celebrateClick" id="0:99"/>
            <StateMachineLayer name="Main" id="0:8">
                <AnyState x="560" y="-140">
                    <!-- 1. Sprint posture wins over everything. -->
                    <StateTransition stateToId="0:51" duration="220" interpolationType="linear">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:84" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <!-- 2. Recovery / cooldown. -->
                    <StateTransition stateToId="0:52" duration="320" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:85" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <!-- 3. Pre-ride contexts (not riding): fatigued slump or eager ready. -->
                    <StateTransition stateToId="0:54" duration="400" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:92" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:81" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:53" duration="280" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:91" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:81" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <!-- 5. Not riding → parked. -->
                    <StateTransition stateToId="0:12" duration="280" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:81" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <!-- 4-6. Cadence tiers: pedal loop speed follows live RPM. -->
                    <StateTransition stateToId="0:15" duration="250" interpolationType="linear">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:80-0:82" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="96"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:14" duration="250" interpolationType="linear">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:80-0:82" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="71"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:13" duration="280" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:81" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="900" y="-140"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>

                <!-- Cadence tiers share PedalIK; speed scales the crank cycle
                     (64f @ 60fps: 1.0 ≈ 56, 1.33 ≈ 75, 1.6 ≈ 90 RPM). -->
                <AnimationState x="160" y="0" animationId="0:60" id="0:12"/>
                <AnimationState x="340" y="0" animationId="0:102" speed="1" id="0:13"/>
                <AnimationState x="520" y="0" animationId="0:102" speed="1.33" id="0:14"/>
                <AnimationState x="700" y="0" animationId="0:102" speed="1.6" id="0:15"/>
                <AnimationState x="160" y="160" animationId="0:103" id="0:51"/>
                <AnimationState x="340" y="160" animationId="0:69" id="0:52"/>
                <AnimationState x="520" y="160" animationId="0:94" id="0:53"/>
                <AnimationState x="700" y="160" animationId="0:95" id="0:54"/>
            </StateMachineLayer>

            <StateMachineLayer name="FX" id="0:9">
                <AnyState x="560" y="120">
                    <!-- Reward ticks / ride finishes → small burst. -->
                    <StateTransition stateToId="0:55" duration="150" interpolationType="linear">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:80-0:87" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <!-- Right-click on the rider → small burst (listener-driven). -->
                    <StateTransition stateToId="0:55" duration="150" interpolationType="linear">
                        <TransitionTriggerCondition inputId="0:99"/>
                    </StateTransition>
                    <!-- PR beaten → big burst. -->
                    <StateTransition stateToId="0:17" duration="150" interpolationType="linear">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:80-0:88" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:55" duration="150" interpolationType="linear">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:80-0:93" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="720" y="120"/>
                <EntryState>
                    <StateTransition stateToId="0:16"/>
                </EntryState>

                <AnimationState x="160" y="120" animationId="0:64" id="0:16"/>
                <AnimationState x="340" y="120" animationId="0:63" id="0:17">
                    <StateTransition stateToId="0:16" duration="300" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="520" y="120" animationId="0:96" id="0:55">
                    <StateTransition stateToId="0:16" duration="300" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>

            <StateMachineLayer name="Speak" id="0:10">
                <AnyState x="560" y="260">
                    <StateTransition stateToId="0:19" duration="180" interpolationType="linear">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:86" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:18" duration="180" interpolationType="linear">
                        <TransitionViewModelCondition opValue="notEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:80-0:86" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="720" y="260"/>
                <EntryState>
                    <StateTransition stateToId="0:18"/>
                </EntryState>

                <AnimationState x="160" y="260" animationId="0:66" id="0:18"/>
                <AnimationState x="340" y="260" animationId="0:67" id="0:19"/>
            </StateMachineLayer>

            <!-- Pointer listeners (Rive 0.9.104 button filter). TapRider writes
                 riderTapped for the host app. NOTE: web runtimes still ignore
                 pointerButtonValue — re-verified on 2.44.1 and 2.44.2: every
                 button matches "primary" and "secondary" never fires — so the
                 host discriminates the button and fires celebrateClick for
                 right-clicks. RightClickRider is kept for native/editor
                 runtimes where the filter does work. -->
            <StateMachineListener targetId="0:97" name="TapRider">
                <ListenerInputTypePointerButton listenerTypeValue="up" pointerButtonValue="primary"/>
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:80-0:98" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="0:97" name="RightClickRider">
                <ListenerInputTypePointerButton listenerTypeValue="down" pointerButtonValue="secondary"/>
                <ListenerTriggerChange inputId="0:99"/>
            </StateMachineListener>
        </StateMachine>

        <!-- EffortPose: 2D upper-body control. x = cadence (relaxed → locked-in
             arms), y = effort (upright casual → aggro crouch); VM numbers map
             through range converters onto −1..1, each axis scrubbing its pose
             range animation. No handleSourceId — x/y are inputs here. -->
        <Joystick name="EffortPose" id="0:104" xId="0:105" yId="0:106">
            <DataBindContext sourcePathIds="0:80-0:82" propertyKey="299" converterId="0:107"/>
            <DataBindContext sourcePathIds="0:80-0:83" propertyKey="300" converterId="0:90"/>
        </Joystick>

        <!--
          Legs are IK-driven: KneeF/KneeR carry IKConstraints (parentBoneCount=1,
          two-bone solve) targeting AnkleTargetF/R — child bones at the crank
          tips. Animations key only the crank RootBones; the bones' rest
          rotations below are starting poses for the solve, and IK collapses
          them to whatever reaches the target. parentBoneCount targets and hip
          rest rotation (0.4808 ≈ thigh down-forward) were screenshot-checked;
          add invertDirection="true" on a knee if it ever bends backwards.
        -->

        <!-- Idle: parked, pedals level, flame out. Legs follow IK — unkeyed. -->
        <LinearAnimation duration="1" name="Idle" id="0:60">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-2.3166" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:44">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="3.1416" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:45">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- PedalIK: ONE crank revolution; the legs are solved by IK off the
             crank-tip target bones, so every cadence tier reuses this
             animation at a different AnimationState speed (Easy 1.0,
             Tempo 1.33, Fast 1.6 — wheel blur scales with it). Crank keys
             carry mid-sweep frames so +π→−π rotation interpolation can't
             collapse onto the zero-length path. -->
        <LinearAnimation duration="64" loopValue="loop" name="PedalIK" id="0:102">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-2.3166" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:44">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="3.1416" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.5708" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.1416" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:45">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.1416" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="-4.7124" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="-6.2832" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:23">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-7.854" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:24">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-7.854" frame="64" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0.3" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- SprintIK: fastest cycle, deepest lean, flame pulsing. -->
        <LinearAnimation duration="40" loopValue="loop" name="SprintIK" id="0:103">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.5" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.5" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:36">
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="-2.5" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:44">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="3.1416" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.5708" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.1416" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:45">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-1.5708" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="-3.1416" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="-4.7124" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-6.2832" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:23">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-12.5664" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:24">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-12.5664" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.3" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="40" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Pose RANGE for the EffortPose joystick x axis (cadence 0–140 →
             −1..1): frame 0 relaxed commuter arms, frame 60 locked-in race
             arms. A range, not motion — the joystick scrubs it, nothing plays
             it. First arm keys in the project; hands stay at the bar because
             both joints bend the same direction by small amounts. -->
        <LinearAnimation duration="60" name="TorsoCadenceRange" id="0:105">
            <KeyedObject objectId="0:38">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="1.7473" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.62" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:39">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.15" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.32" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Pose RANGE for the joystick y axis (effort 0–1 → −1..1; handle up
             = frame 0 = upright casual): torso leans forward, head
             counter-rotates to keep the eyes on the road. -->
        <LinearAnimation duration="60" name="TorsoEffortRange" id="0:106">
            <KeyedObject objectId="0:35">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.18" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:37">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-0.14" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Recovery: pedals parked, slow breathing sag, sat back up. -->
        <LinearAnimation duration="96" loopValue="loop" name="Recovery" id="0:69">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.2" frame="48" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="96" interpolationType="linear"/>
