<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" viewModelId="0:80" styleId="0:5" width="160" height="160" name="Rider" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!--
          Rider v2 — an actual cyclist, not a blob.
          Side profile facing +x: articulated pedaling legs (hip/knee two-segment,
          keyed from an 8-pose IK solve of the crank circle), frame tubes, cranks
          with pedals, gradient jersey + helmet.

          Reactivity:
          - cadence  → Main-layer number conditions pick Easy/Tempo/Fast pedal loops
          - effort   → data-bound to TorsoLean rotation via EffortToLean mapper
          - isSprint / isRecovery / isRiding → posture states
          - isSpeaking → Speak layer (mouth) · rewardPulse / prPulse → FX layer (burst)

          Draw order is front-to-back: first declared paints on top.
        -->

        <!-- Celebrate burst: pops on rewardPulse / prPulse (FX layer). -->
        <Shape x="80" y="30" rotation="0.7853982" name="Burst" id="0:30" opacity="0" scaleX="0" scaleY="0">
            <Rectangle width="16" height="16" cornerRadiusTL="4" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFFBBF24" name="Color"/></Fill>
        </Shape>

        <!-- ─── Rider body (bobbed as a unit) ─────────────────────── -->
        <Node x="0" y="0" name="RiderBody" id="0:20">

            <!-- Front leg: bone chain, knee solved by IK onto the pedal. -->
            <RootBone x="62" y="76" length="26" rotation="0.4808" name="HipF" id="0:40">
                <Shape x="0" y="0" name="ThighF">
                    <Rectangle width="26" height="8" cornerRadiusTL="3" originX="0" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF334155" name="Color"/></Fill>
                </Shape>
                <Bone length="28" rotation="0" name="KneeF" id="0:41">
                    <IKConstraint targetId="0:100" parentBoneCount="1" strength="1" name="KneeSolveF"/>
                    <Shape x="0" y="0" name="CalfF">
                        <Rectangle width="28" height="6" cornerRadiusTL="3" originX="0" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFE2E8F0" name="Color"/></Fill>
                    </Shape>
                    <Shape x="28" y="0" name="ShoeF">
                        <Rectangle width="10" height="5" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
                    </Shape>
                </Bone>
            </RootBone>

            <!-- Torso assembly: EffortPose joystick leans TorsoLean (2D pose
                 range, Step 3), state-machine animations pose TorsoPose. -->
            <Node x="62" y="76" name="TorsoLean" id="0:35">
                <Node x="0" y="0" rotation="-2.3166" name="TorsoPose" id="0:36">
                    <Shape x="0" y="0" name="Torso" id="0:22">
                        <Rectangle width="12" height="35" cornerRadiusTL="6" originX="0.5" originY="0" name="Path"/>
                        <Fill name="Fill">
                            <LinearGradient startX="0" startY="0" endX="0" endY="35" name="Gradient">
                                <GradientStop colorValue="FFFBBF24" position="0"/>
                                <GradientStop colorValue="FFF59E0B" position="1"/>
                            </LinearGradient>
                        </Fill>
                    </Shape>
                    <!-- Arm: shoulder → handlebar. -->
                    <Node x="0" y="35" rotation="1.7473" name="ArmNode" id="0:38">
                        <Shape x="0" y="0" name="Sleeve">
                            <Rectangle width="7" height="14" cornerRadiusTL="3" originX="0.5" originY="0" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFF59E0B" name="Color"/></Fill>
                        </Shape>
                        <Node x="0" y="13" rotation="0.15" name="ForearmNode" id="0:39">
                            <Shape x="0" y="0" name="Forearm">
                                <Rectangle width="6" height="19" cornerRadiusTL="3" originX="0.5" originY="0" name="Path"/>
                                <Fill name="Fill"><SolidColor colorValue="FFF1F5F9" name="Color"/></Fill>
                            </Shape>
                        </Node>
                    </Node>
                    <!-- Head + helmet at the shoulder end, facing +x. -->
                    <Node x="0" y="36" name="HeadNode" id="0:37">
                        <Shape x="7" y="2" name="Mouth" id="0:34" opacity="0">
                            <Rectangle width="8" height="4" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="E61E293B" name="Color"/></Fill>
                        </Shape>
                        <Shape x="0" y="-6" name="Helmet" id="0:27">
                            <Ellipse width="21" height="13" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill">
                                <LinearGradient startX="0" startY="-6" endX="0" endY="6" name="Gradient">
                                    <GradientStop colorValue="FF8B9DFF" position="0"/>
                                    <GradientStop colorValue="FF4F46E5" position="1"/>
                                </LinearGradient>
                            </Fill>
                        </Shape>
                        <Shape x="1" y="0" name="Head" id="0:26">
                            <Ellipse width="18" height="18" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFF1F5F9" name="Color"/></Fill>
                        </Shape>
                    </Node>
                </Node>
            </Node>

            <!-- Rear leg: same rig, half a crank revolution behind, darker. -->
            <RootBone x="62" y="76" length="26" rotation="0.4808" name="HipR" id="0:42">
                <Shape x="0" y="0" name="ThighR">
                    <Rectangle width="26" height="7" cornerRadiusTL="3" originX="0" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF1F2937" name="Color"/></Fill>
                </Shape>
                <Bone length="28" rotation="0" name="KneeR" id="0:43">
                    <IKConstraint targetId="0:101" parentBoneCount="1" strength="1" name="KneeSolveR"/>
                    <Shape x="0" y="0" name="CalfR">
                        <Rectangle width="28" height="6" cornerRadiusTL="3" originX="0" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFCBD5E1" name="Color"/></Fill>
                    </Shape>
                    <Shape x="28" y="0" name="ShoeR">
                        <Rectangle width="10" height="5" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF0F172A" name="Color"/></Fill>
                    </Shape>
                </Bone>
            </RootBone>
        </Node>

        <!-- Sprint flame trailing behind the rear wheel. -->
        <Shape x="28" y="108" name="Flame" id="0:31" opacity="0">
            <Ellipse width="26" height="14" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFFB7185" name="Color"/></Fill>
        </Shape>

        <!-- Cranks: bones keyed through the cycle; the pedal-axle target bones
             drive each leg's IK. Old Node rotations +π/2 (shapes now along +x). -->
        <RootBone x="76" y="116" length="10" rotation="3.1416" name="CrankF" id="0:44">
            <Shape x="0" y="0" name="CrankArmF">
                <Rectangle width="10" height="4" cornerRadiusTL="2" originX="0" originY="0.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF475569" name="Color"/></Fill>
            </Shape>
            <Shape x="10" y="0" name="PedalF">
                <Ellipse width="7" height="5" originX="0.5" originY="0.5" name="Path"/>
