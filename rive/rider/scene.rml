            <Shape x="10" y="0" name="PedalR">
                <Ellipse width="7" height="5" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
            </Shape>
            <Bone length="0" rotation="0" name="AnkleTargetR" id="0:101"/>
        </RootBone>

        <!-- Cockpit + frame. -->
        <Shape x="61" y="82" name="Saddle" id="0:28">
            <Rectangle width="16" height="5" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="103" y="75" name="Hood">
            <Rectangle width="7" height="4" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF1E293B" name="Color"/></Fill>
        </Shape>
        <Shape x="106" y="80" name="Handlebar" id="0:29">
            <Rectangle width="5" height="12" cornerRadiusTL="2" originX="0.5" originY="0.5" name="Path"/>
