                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.7" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="0.6" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.9" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="0.9" frame="14" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- FX idle: burst parked at zero. -->
        <LinearAnimation duration="1" name="FxIdle" id="0:64">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
