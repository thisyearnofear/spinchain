    </Artboard>

    <!-- effort 0–1 → extra torso lean 0–0.18 rad -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="-1" maxOutput="1" clampLower="true" clampUpper="true" name="EffortToPoseY" id="0:90"/>
    <DataConverterRangeMapper minInput="0" maxInput="140" minOutput="-1" maxOutput="1" clampLower="true" clampUpper="true" name="CadenceToPoseX" id="0:107"/>

