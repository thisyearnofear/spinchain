            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Fatigued: honest high-load days — slow heavy sag, hunched torso. -->
        <LinearAnimation duration="120" loopValue="loop" name="Fatigued" id="0:95">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="2" frame="60" interpolationType="cubic"/>
                    <KeyFrameDouble value="0" frame="120" interpolationType="cubic"/>
