            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- CelebrateSmall: reward ticks + ride finishes (PR keeps the big one). -->
        <LinearAnimation duration="20" name="CelebrateSmall" id="0:96">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.7" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="0.6" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.7" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="0.6" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.9" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="0.9" frame="14" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="20" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- FX idle: burst parked at zero. -->
        <LinearAnimation duration="1" name="FxIdle" id="0:64">
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Mute: mouth hidden. -->
        <LinearAnimation duration="1" name="Mute" id="0:66">
            <KeyedObject objectId="0:34">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Chatting: mouth visible with bounce while coach speaks. -->
        <LinearAnimation duration="30" loopValue="loop" name="Chatting" id="0:67">
            <KeyedObject objectId="0:34">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.7" frame="7" interpolationType="linear"/>
                    <KeyFrameDouble value="0.8" frame="15" interpolationType="linear"/>
                    <KeyFrameDouble value="1.5" frame="22" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="30" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- effort 0–1 → extra torso lean 0–0.18 rad -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="0.18" clampLower="true" clampUpper="true" name="EffortToLean" id="0:90"/>

