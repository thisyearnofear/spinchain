        </LinearAnimation>

        <!-- Mute: mouth hidden. -->
        <LinearAnimation duration="1" name="Mute" id="0:66">
            <KeyedObject objectId="0:34">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
