                <ExitState x="720" y="-140"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>

                <AnimationState x="160" y="0" animationId="0:60" id="0:12"/>
                <AnimationState x="340" y="0" animationId="0:61" id="0:13"/>
                <AnimationState x="520" y="0" animationId="0:62" id="0:14"/>
