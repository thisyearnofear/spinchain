            </Shape>
            <Bone length="0" rotation="0" name="AnkleTargetF" id="0:100"/>
        </RootBone>
        <RootBone x="76" y="116" length="10" rotation="0" name="CrankR" id="0:45">
            <Shape x="0" y="0" name="CrankArmR">
                <Rectangle width="10" height="4" cornerRadiusTL="2" originX="0" originY="0.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF475569" name="Color"/></Fill>
