<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="160" height="160" name="Rider" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Draw order is front-to-back: first declared paints on top. -->

        <!-- Celebrate burst: pops on rewardPulse / prPulse. -->
        <Shape x="80" y="34" rotation="0.7853982" name="Burst" id="0:30" opacity="0" scaleX="0" scaleY="0">
